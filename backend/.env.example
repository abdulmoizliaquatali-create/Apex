# Copy to `.env` (same directory) and fill in your values.
# The app runs fine with none of these set (local JSON file store).
# Never commit the real `.env` — it is gitignored.

# --- Supabase (optional, recommended for durable cloud persistence) ---
# Create a free project at https://supabase.com, then run the schema:
#   backend/supabase/migrations/0001_init.sql  (SQL Editor -> New query -> Run)
# Find the values under Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the SERVICE_ROLE key (bypasses row-level security; server-side only).
# Do NOT expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Fallback only (row-level security will block reads if used alone).
#SUPABASE_ANON_KEY=your-anon-key

# --- App secrets / behaviour ---
# Secret used to sign login tokens. Set a long random string in production.
#AUTH_SECRET=change-me-to-a-long-random-string

# FX auto-refresh interval in hours (default 6).
#FX_REFRESH_HOURS=6
